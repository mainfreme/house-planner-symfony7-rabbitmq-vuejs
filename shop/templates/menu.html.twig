<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">Moja Strona</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            {% if menuService.getMenuItems() is not empty %}
                {# Menu po lewej stronie - wszystkie oprócz Ustawienia #}
                <ul class="navbar-nav me-auto">
                    {% for item in menuService.getMenuItems() %}
                        {% if item.title != 'Ustawienia' %}
                            {# {% if item.isGranted is not defined or item.isGranted is empty or is_granted(item.isGranted[0]) %} #}
                                {% if item.children is empty or item.children|length == 0 %}
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ item.link }}">{{ item.title }}</a>
                                    </li>
                                {% else %}
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="dropdown-{{ loop.index }}" role="button"
                                           data-bs-toggle="dropdown" aria-expanded="false">
                                            {{ item.title }}
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="dropdown-{{ loop.index }}">
                                            {% for child in item.children %}
                                                <li><a class="dropdown-item" href="{{ child.link }}">{{ child.title }}</a></li>
                                            {% endfor %}
                                        </ul>
                                    </li>
                                {% endif %}
                            {# {% endif %} #}
                        {% endif %}
                    {% endfor %}
                </ul>

                {# Menu po prawej stronie - tylko Ustawienia #}
                <ul class="navbar-nav ms-auto">
                    {% for item in menuService.getMenuItems() %}
                        {% if item.title == 'Ustawienia' %}
                            {# {% if item.isGranted is not defined or item.isGranted is empty or is_granted(item.isGranted[0]) %} #}
                                {% if item.children is empty or item.children|length == 0 %}
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ item.link }}">{{ item.title }}</a>
                                    </li>
                                {% else %}
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="dropdown-settings" role="button"
                                           data-bs-toggle="dropdown" aria-expanded="false">
                                            {{ item.title }}
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdown-settings">
                                            {% for child in item.children %}
                                                <li><a class="dropdown-item" href="{{ child.link }}">{{ child.title }}</a></li>
                                            {% endfor %}
                                        </ul>
                                    </li>
                                {% endif %}
                            {# {% endif %} #}
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</nav>

<script>
    // Inicjalizacja dropdownów Bootstrap 5
    function initBootstrapDropdowns() {
        // Sprawdź czy Bootstrap jest dostępny
        if (typeof bootstrap === 'undefined') {
            console.log('Bootstrap nie jest jeszcze załadowany, czekam...');
            // Jeśli Bootstrap nie jest jeszcze załadowany, spróbuj ponownie za 100ms
            setTimeout(initBootstrapDropdowns, 100);
            return;
        }

        console.log('Bootstrap jest dostępny, inicjalizuję dropdowny...');

        // Pobierz wszystkie elementy dropdown-toggle
        const dropdownElementList = document.querySelectorAll('.dropdown-toggle');
        console.log('Znaleziono ' + dropdownElementList.length + ' elementów dropdown');
        
        // Inicjalizuj każdy dropdown
        dropdownElementList.forEach(function(dropdownToggleEl) {
            try {
                // Sprawdź czy dropdown nie jest już zainicjalizowany
                const existingInstance = bootstrap.Dropdown.getInstance(dropdownToggleEl);
                if (existingInstance) {
                    console.log('Dropdown już zainicjalizowany:', dropdownToggleEl.id);
                    return;
                }

                // Utwórz instancję dropdown dla każdego elementu
                new bootstrap.Dropdown(dropdownToggleEl, {
                    autoClose: true,
                    boundary: 'viewport'
                });
                console.log('Zainicjalizowano dropdown:', dropdownToggleEl.id || dropdownToggleEl.textContent);
            } catch (e) {
                console.error('Błąd inicjalizacji dropdown:', e, dropdownToggleEl);
            }
        });
    }

    // Uruchom inicjalizację po załadowaniu DOM i Bootstrap
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            // Poczekaj jeszcze chwilę na załadowanie Bootstrap JS
            setTimeout(initBootstrapDropdowns, 50);
        });
    } else {
        // DOM jest już załadowany, ale Bootstrap może jeszcze nie być
        setTimeout(initBootstrapDropdowns, 50);
    }
</script>
