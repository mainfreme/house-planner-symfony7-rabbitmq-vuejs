<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <script src="https://kit.fontawesome.com/91a4a7b7dd.js" crossorigin="anonymous"></script>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {{ encore_entry_link_tags('app') }}

    {% block stylesheets %}{% endblock %}
</head>
<body>
{% include 'menu.html.twig' %}
{% block body %}{% endblock %}

<div id="app"></div>

{# Two options: Bootstrap JS przed Twoim app.js lub po - ale musi być wewnątrz body #}
<!-- Bootstrap JS (zawiera Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Twoje skrypty (Vue / Webpack encore bundle) -->
{{ encore_entry_script_tags('app') }}

{% block javascripts %}{% endblock %}
</body>
</html>
